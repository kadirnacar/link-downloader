# ytdlp-studio:dockerfile-linux v4
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
ENV CGO_ENABLED=1
ARG GOARCH=amd64
ARG GO_VERSION=1.27.3
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config curl ca-certificates git \
    libgtk-4-dev libwebkitgtk-6.0-dev libsoup-3.0-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pkg-config --exists gtk4 webkitgtk-6.0 libsoup-3.0
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GOARCH}.tar.gz" | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOMODCACHE=/go/pkg/mod
ENV GOCACHE=/root/.cache/go-build
WORKDIR /app
